[app]

title = FB YT Bot
package.name = fbytbot
package.domain = org.fbytbot
source.dir = .
source.exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3==3.11,kivy
orientation = portrait
android.api = 33
android.min_api = 21
android.ndk = 25b
android.accept_sdk_license = True
android.archs = arm64-v8a

[buildozer]
log_level = 2
warn_on_root = 1
